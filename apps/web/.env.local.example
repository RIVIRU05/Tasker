# Copy this file to .env.local and fill in your Firebase project's web app config
# (Firebase console → Project settings → General → Your apps → Web app → SDK setup and config).
#
# Leave NEXT_PUBLIC_USE_MOCK=true (or unset) to keep running on local mock data.
# Set it to "false" once the Firebase values below are filled in.

NEXT_PUBLIC_USE_MOCK=true

# Comma-separated list of emails allowed into /admin (dispute resolution).
NEXT_PUBLIC_ADMIN_EMAILS=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Copy this file to .env and fill in your Firebase project's web app config
# (same values as apps/web/.env.local.example — same Firebase project, both apps
# share one backend).
#
# Leave EXPO_PUBLIC_USE_MOCK=true (or unset) to keep running on local mock data.

EXPO_PUBLIC_USE_MOCK=true

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

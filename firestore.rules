rules_version = '2';

// Demo/launch-day rules: any signed-in user can read and write app data.
// This is intentionally permissive to ship fast — it does NOT stop a logged-in
// user from editing another user's task/profile via a direct API call. Tighten
// with per-field checks (e.g. only the task owner can edit a task, only the
// bid owner can create a bid) once there's time post-launch.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null;
    }

    match /tasks/{taskId} {
      allow read: if true;
      allow create, update: if request.auth != null;
    }

    match /bids/{bidId} {
      allow read: if true;
      allow create, update: if request.auth != null;
    }

    match /messages/{messageId} {
      allow read, create: if request.auth != null;
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if request.auth != null;
    }

    match /disputes/{disputeId} {
      allow read, create, update: if request.auth != null;
    }

    match /transactions/{transactionId} {
      allow read, create, update: if request.auth != null;
    }
  }
}

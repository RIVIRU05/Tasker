rules_version = '2';

// Demo/launch-day rules, matching the same permissive-by-design approach as
// firestore.rules: any signed-in user can upload or delete; photos are
// publicly readable since they're shown on task/worker pages to anyone
// browsing. Tighten to per-task ownership checks once there's time post-launch.
service firebase.storage {
  match /b/{bucket}/o {
    match /task-photos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    match /completion-photos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
  }
}
